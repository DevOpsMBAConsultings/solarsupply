<odoo>
    <data>
  <record id="product_template_form_view_dgi" model="ir.ui.view">
    <field name="name">product.template.form.dgi</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="attributes">
        <attribute name="placeholder">Referencia interna (obligatoria)</attribute>
      </xpath>
      <xpath expr="//field[@name='categ_id']" position="before">
        <field name="is_dgi_generic" string="Es producto genérico (DGI)"/>
      </xpath>
      <xpath expr="//page[@name='general_information']/group" position="inside">
        <group string="DGI / Facturación Electrónica">
          <field name="dgi_charge_type" options="{'no_create': True}" placeholder="¿Para Seguro, Acarreo, otros Gastos?" help="Si elige Acarreo, Seguro u Otros Gastos, la línea va al NUC como cargo (F03 TotalCharges / E10 Charges). No lleva CPBS ni unidad: no tiene que poner más nada en DGI para este producto."/>
          <field name="dgi_unidad_medida_id" placeholder="Seleccione unidad de medida (DGI)"/>
          <field name="dgi_cpbs_segment_id" placeholder="Seleccione clasificación (segmento)" help="Requerido para ítems normales (no cargos). Si el producto es Cargo DGI (Acarreo, Seguro, Otros Gastos), no es obligatorio: el cargo no lleva CPBS en el NUC."/>
          <field name="dgi_cpbs_family_id" placeholder="Seleccione subclasificación (familia)" domain="[('segment_id', '=', dgi_cpbs_segment_id)]"/>
          <!-- <field name="dgi_cpbs_abrev"/> -->
          <!-- <field name="dgi_cpbs_codigo"/> -->
        </group>
      </xpath>
    </field>
  </record>
    </data>
</odoo>