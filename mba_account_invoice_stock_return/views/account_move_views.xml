<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_stock_return" model="ir.ui.view">
        <field name="name">account.move.form.inherit.stock.return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Invisible helper -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="has_sale_order" invisible="1"/>
                <field name="reconciliation_alert_type" invisible="1"/>
                <field name="credit_note_count" invisible="1"/>
            </xpath>

            <!-- Semáforo / Banner informativo de conciliación en Notas de Crédito -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-success d-flex align-items-center mb-2" role="alert"
                     invisible="reconciliation_alert_type != 'auto_reconciled'">
                    <span>✅ <strong>Nota de Crédito Cruzada:</strong> Este documento se aplicó automáticamente contra la Factura original. Ambas cuentas quedan saldadas en B/. 0.00.</span>
                </div>
                <div class="alert alert-warning d-flex align-items-center mb-2" role="alert"
                     invisible="reconciliation_alert_type != 'credit_available'">
                    <span>ℹ️ <strong>Saldo a Favor del Cliente:</strong> La factura original ya había sido pagada previamente. Esta Nota de Crédito queda como saldo a favor del cliente para futuras compras o reembolso.</span>
                </div>
                <div class="alert alert-info d-flex justify-content-between align-items-center mb-2" role="alert"
                     invisible="reconciliation_alert_type != 'pending_reconcile'">
                    <span>⚡ <strong>Factura con Saldo Pendiente:</strong> La factura original tiene saldo por saldar.</span>
                    <button name="action_auto_reconcile_with_invoice" type="object" string="Cruzar Saldo Ahora" class="btn btn-sm btn-primary"/>
                </div>
            </xpath>

            <!-- Stat buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_credit_notes"
                        icon="fa-undo"
                        invisible="move_type != 'out_invoice' or credit_note_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="credit_note_count"/></span>
                        <span class="o_stat_text">Notas Crédito</span>
                    </div>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_stock_return_wizard"
                        icon="fa-truck"
                        invisible="(move_type == 'out_refund' and stock_return_picking_id) or (move_type == 'out_invoice' and (state != 'cancel' or stock_return_picking_id))">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Regresar a</span>
                        <span class="o_stat_text">Bodega</span>
                    </div>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_stock_delivery_wizard"
                        icon="fa-truck"
                        invisible="move_type != 'out_invoice' or has_sale_order or stock_delivery_picking_id or state == 'cancel'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Despachar de</span>
                        <span class="o_stat_text">Bodega</span>
                    </div>
                </button>
            </xpath>

            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_open_stock_return_wizard"
                        string="Devolver a Bodega"
                        type="object"
                        class="btn-secondary"
                        invisible="(move_type == 'out_refund' and (state != 'posted' or stock_return_picking_id)) or (move_type == 'out_invoice' and (state != 'cancel' or stock_return_picking_id))"/>
                <button name="action_open_stock_delivery_wizard"
                        string="Despachar de Bodega"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or has_sale_order or stock_delivery_picking_id"/>
                <button name="action_open_stock_exchange_wizard"
                        string="Exchange / Cambio"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>

            <!-- Fields after reversed entry / invoice origin -->
            <xpath expr="//field[@name='reversed_entry_id']" position="after">
                <field name="stock_return_picking_id"
                       options="{'no_create': True}"
                       invisible="move_type != 'out_refund' or not stock_return_picking_id"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="stock_delivery_picking_id"
                       options="{'no_create': True}"
                       invisible="move_type != 'out_invoice' or not stock_delivery_picking_id"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
