<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_dgi_warning_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.dgi.warning.wizard.form</field>
        <field name="model">sale.order.dgi.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Cliente no Validado con DGI">
                <field name="sale_order_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading"><i class="fa fa-warning me-2"/>Cliente no Validado con DGI</h4>
                    <p>
                        El cliente <strong><field name="partner_name" readonly="1" class="oe_inline"/></strong> no ha sido validado con la DGI.
                    </p>
                    <p class="mb-0">
                        Va a crear una factura borrador con un cliente que no está validado ante la DGI. Al intentar procesar o emitir la factura electrónica esta podría no ser aceptada.
                    </p>
                </div>
                <footer>
                    <button string="Crear Borrador de Factura" name="action_confirm_create_invoice" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
