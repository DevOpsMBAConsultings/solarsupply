<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hka_anular_factura_wizard_form" model="ir.ui.view">
            <field name="name">hka.anular.factura.wizard.form</field>
            <field name="model">hka.anular.factura.wizard</field>
            <field name="arch" type="xml">
                <form string="Anular Factura">
                    <group>
                        <field name="move_id" invisible="1"/>
                        <field name="cufe" readonly="1"/>
                    </group>
                    <group>
                        <field name="motivo" placeholder="Ej. Error en los datos del cliente, duplicidad, etc." required="1"/>
                    </group>
                    
                    <div class="alert alert-warning mb-0" role="alert">
                        <strong>Atención:</strong> Esta acción anulará de forma definitiva el documento ante la DGI. El número fiscal no podrá ser reutilizado. El documento en Odoo pasará a estado <strong>Cancelado</strong> y en la DGI a un estado de <strong>Anulado</strong>.
                    </div>

                    <footer>
                        <button name="action_anular" type="object" string="Confirmar Anulación" class="btn-danger" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hka_anular_factura_wizard" model="ir.actions.act_window">
            <field name="name">Anular Factura</field>
            <field name="res_model">hka.anular.factura.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
