<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_sale_order_payment_other_desc_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.payment.other.desc.wizard.form</field>
        <field name="model">sale.order.payment.other.desc.wizard</field>
        <field name="arch" type="xml">
            <form string="Descripción de forma de pago (99 - Otro)">
                <group>
                    <field name="sale_order_id" options="{'no_create': True}" invisible="1"/>
                    <field name="dgi_payment_method_other_desc"
                           placeholder="Indique el método de pago (ej: Transferencia, cheque a nombre de...)"
                           nolabel="0"/>
                </group>
                <footer>
                    <button name="action_create_invoice"
                            string="Crear factura"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
