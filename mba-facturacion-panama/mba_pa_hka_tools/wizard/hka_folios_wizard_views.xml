<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hka_folios_wizard_form" model="ir.ui.view">
        <field name="name">hka.folios.wizard.form</field>
        <field name="model">hka.folios.wizard</field>
        <field name="arch" type="xml">
            <form string="Consulta de Folios Restantes HKA">
                <field name="is_success" invisible="1"/>
                
                <div class="alert alert-success d-flex align-items-center" role="alert" invisible="not is_success">
                    <i class="fa fa-check-circle fa-2x me-2"/>
                    <div>
                        <strong><field name="status_message" readonly="1"/></strong>
                    </div>
                </div>

                <div class="alert alert-warning d-flex align-items-center" role="alert" invisible="is_success">
                    <i class="fa fa-exclamation-triangle fa-2x me-2"/>
                    <div>
                        <strong><field name="status_message" readonly="1"/></strong>
                        <div invisible="not error_message" class="mt-1">
                            <field name="error_message" readonly="1"/>
                        </div>
                    </div>
                </div>

                <notebook invisible="not is_success">
                    <page string="Resumen de Folios" name="summary">
                        <group>
                            <group string="Saldo de Licencia">
                                <field name="folios_totales_disponibles" class="fw-bold fs-4 text-primary"/>
                                <field name="licencia"/>
                                <field name="fecha_licencia"/>
                            </group>
                            <group string="Detalle del Ciclo Actual">
                                <field name="folios_disponibles_ciclo" class="fw-bold text-success"/>
                                <field name="folios_utilizados_ciclo"/>
                                <field name="folios_totales_ciclo"/>
                                <field name="ciclo"/>
                                <field name="fecha_ciclo"/>
                            </group>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_refresh" string="Actualizar / Consultar de nuevo" type="object" class="btn-primary" icon="fa-refresh"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hka_folios_wizard" model="ir.actions.act_window">
        <field name="name">Consultar Folios Restantes HKA</field>
        <field name="res_model">hka.folios.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
