<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_sale_order_credit_other_due_date_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.credit.other.due.date.wizard.form</field>
        <field name="model">sale.order.credit.other.due.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Fecha de vencimiento (Crédito otro)">
                <group>
                    <field name="sale_order_id" options="{'no_create': True}"/>
                    <field name="dgi_plazo_due_date"
                           placeholder="Indique la fecha de vencimiento del crédito"/>
                </group>
                <footer>
                    <button name="action_create_invoice"
                            string="Crear factura"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
